# Supabase Configuration
# Get these from your Supabase project: https://app.supabase.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# API Endpoints Configuration
# For development (Lovable/local)
VITE_API_URL=http://localhost:8080
VITE_API_ENV=development

# For staging/production (update as needed)
# VITE_API_URL=https://api.ditechai.com
# VITE_API_ENV=production

# Payment Gateway (Stripe/Shopify)
# Publishable key only — NEVER put secret keys in VITE_ variables; they ship in the public bundle.
# Secret keys (Stripe secret, Shopify token) belong in server-side edge function secrets.
# VITE_STRIPE_PUBLIC_KEY=pk_live_your_key
# VITE_SHOPIFY_STORE_NAME=your-store

# Email Service (e.g., SendGrid, Mailgun)
# VITE_EMAIL_SERVICE_API_KEY=your_key
# VITE_EMAIL_FROM=noreply@ditechai.com

# Analytics & Monitoring
# VITE_SENTRY_DSN=https://your-sentry-dsn
# VITE_GA_TRACKING_ID=G-your-id

# Feature Flags
VITE_ENABLE_SHOP=true
VITE_ENABLE_ADMIN=true
VITE_ENABLE_CHECKOUT=true

# Notes:
# - Prefix all frontend variables with VITE_ (Vite requirement)
# - Never commit actual secrets; use secret managers (AWS Secrets Manager, HashiCorp Vault)
# - Rotate credentials regularly
# - Use different values per environment (dev/staging/prod)
